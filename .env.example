# ========================================================
# Database Configuration Template (ModPyPhp ERP)
# Copy this file to .env and fill in your database credentials
# ========================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=modpyphp
DB_USER=postgres
DB_PASS=your_password_here
DB_SSLMODE=disable

# Direct Connection URL (Optional)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/modpyphp?sslmode=disable
